source "https://rubygems.org"

# Lock Jekyll version to what GitHub Pages supports for consistency
# See: https://pages.github.com/versions/
gem "jekyll", "~> 3.9.3"

# Declare the theme as a gem dependency
gem "jekyll-theme-minimal"

# This gem is required by the jekyll-theme-minimal
gem "jekyll-include-cache", "~> 0.2.1"

# Required for GitHub Flavored Markdown parsing
gem "kramdown-parser-gfm"